# ============================================================
# Manuver Portfolio - Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit your real .env file to Git!
# ============================================================

# Google Gemini AI API Key (Get at https://aistudio.google.com/)
AI_API_KEY=your_gemini_api_key_here

# AI Model Name (Optional)
AI_MODEL=gemini-2.5-flash-lite

# PostgreSQL Database Connection
# Supports local postgres or cloud (Neon, Supabase DB, Railway, Aiven, etc.)
DATABASE_URL=postgresql://postgres:password@localhost:5432/manuver_db

# Google OAuth 2.0 Credentials (From Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# JWT Secret for Session Cookies
JWT_SECRET=manuver_super_secure_jwt_secret_key_2026
