# ============================================================
# Manuver Portfolio - Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit your real .env file to Git!
# ============================================================

# Google Gemini AI API Key (Free tier available at https://aistudio.google.com/)
AI_API_KEY=your_gemini_api_key_here

# AI Model Name (Optional, defaults to gemini-1.5-flash)
AI_MODEL=gemini-1.5-flash

# Supabase Auth Configuration (Optional)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

